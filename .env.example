# Copy to .env and fill in. Never commit .env.

# Network: testnet | devnet | mainnet. Start on testnet.
SUI_NETWORK=testnet

# Optional: override the public fullnode URL (e.g. a private RPC provider).
SUI_RPC_URL=

# Bech32 private key (suiprivkey1...) of the deployer.
# Export it: sui keytool export --key-identity <alias>
# Use a DEDICATED deployer key, never your main wallet.
SUI_PRIVATE_KEY=

# Filled in after running npm run publish
PACKAGE_ID=
COLLECTION_ID=
COLLECTION_CAP_ID=

# Collection settings
COLLECTION_NAME=My Collection
COLLECTION_SYMBOL=MYC
MAX_SUPPLY=1000

# Mint settings (npm run mint). MINT_RECIPIENT defaults to your own address.
NFT_NAME=My NFT #1
NFT_DESCRIPTION=A professional NFT minted on Sui.
NFT_URL=https://example.com/nft.png
NFT_ATTRIBUTES_JSON={"Background":"Forest","Eyes":"Amber"}
MINT_RECIPIENT=
